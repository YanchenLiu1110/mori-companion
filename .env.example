# MORI prototype environment variables
#
# The app runs fully in mock mode with this file absent.
#
# Optional: point this at YOUR server-side proxy that holds the real LLM key.
# The proxy must return JSON: { "reply": "..." }
# Do not put an API key in this file — VITE_* values are exposed to the browser.
VITE_MORI_LLM_ENDPOINT=
