# MORI — environment variables
#
# ---------------------------------------------------------------
# SERVER SIDE (set these in Netlify: Site configuration → Environment variables)
# ---------------------------------------------------------------
# Required for live Gemini chat. Get it from https://aistudio.google.com/apikey
# GEMINI_API_KEY=AIza...
#
# Optional: extra keys for automatic rotation when one hits its quota.
# GEMINI_API_KEYS=AIza...key2,AIza...key3
#
# Optional: override the model (default gemini-2.5-flash).
# GEMINI_MODEL=gemini-2.5-flash
#
# ---------------------------------------------------------------
# BROWSER SIDE (Vite build-time; NEVER put a key here)
# ---------------------------------------------------------------
# Leave empty in production: the app calls /.netlify/functions/companion.
# Set only when running the UI against a local proxy, e.g. /api/companion
VITE_MORI_LLM_ENDPOINT=
